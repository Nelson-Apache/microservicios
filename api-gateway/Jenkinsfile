pipeline {
    agent any

    environment {
        SERVICE_NAME    = 'api-gateway'
        DOCKER_REGISTRY = 'localhost:5000'
        IMAGE_NAME      = "${DOCKER_REGISTRY}/${SERVICE_NAME}"
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        SONAR_HOST_URL  = 'http://sonarqube:9000'
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '--network microservices-network'
                    reuseNode true
                }
            }
            steps {
                dir("${SERVICE_NAME}") {
                    sh 'pip install --no-cache-dir -r requirements.txt -q'
                }
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '--network microservices-network'
                    reuseNode true
                }
            }
            steps {
                dir("${SERVICE_NAME}") {
                    sh 'pip install --no-cache-dir -r requirements.txt -q'
                    sh 'pytest --cov=. --cov-report=xml --cov-report=term-missing tests/ -v'
                }
            }
        }

        stage('Quality Gate') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '--network microservices-network'
                    reuseNode true
                }
            }
            steps {
                dir("${SERVICE_NAME}") {
                    sh 'pip install --no-cache-dir coverage -q'
                    sh 'coverage report --fail-under=70'
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir("${SERVICE_NAME}") {
                    sh """
                        docker run --rm \
                            --network microservices-network \
                            -v \$(pwd):/usr/src \
                            sonarsource/sonar-scanner-cli \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.login=admin \
                            -Dsonar.password=admin123 \
                            -Dsonar.projectKey=${SERVICE_NAME} \
                            -Dsonar.projectName='API Gateway' \
                            -Dsonar.sources=. \
                            -Dsonar.exclusions=tests/** \
                            -Dsonar.python.coverage.reportPaths=coverage.xml
                    """
                }
            }
        }

        stage('Package') {
            steps {
                dir("${SERVICE_NAME}") {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                    sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest"
                    sh "docker push ${IMAGE_NAME}:latest"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline de ${SERVICE_NAME} completado exitosamente."
        }
        failure {
            echo "Pipeline de ${SERVICE_NAME} falló."
        }
    }
}
